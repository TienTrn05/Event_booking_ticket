{
  "name": "@event-ticketing/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "setup:env": "node tooling/setup-env.mjs",
    "lint": "eslint --config eslint.config.mjs src tooling vite.config.ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tooling/*.mjs\" \"*.{json,html,ts,md}\" \"config/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tooling/*.mjs\" \"*.{json,html,ts,md}\" \"config/**/*.js\"",
    "check": "npm run lint && npm run typecheck && npm run build && npm run format:check"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.21",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
