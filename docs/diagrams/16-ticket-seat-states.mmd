stateDiagram-v2
    state "Ticket" as Ticket {
      [*] --> VALID: Xác nhận đơn
      VALID --> USED: Admission sau CheckIn, nguyên tử
      VALID --> CANCELLED: Thu hồi quyền
      VALID --> EXPIRED: Hết cửa sổ admission
      CANCELLED --> REFUNDED: Hoàn thành công
      USED --> [*]
      EXPIRED --> [*]
      REFUNDED --> [*]
    }
    state "SessionSeat" as Seat {
      [*] --> AVAILABLE
      AVAILABLE --> HELD: Giữ nhóm ghế
      HELD --> SOLD: Xác nhận đơn
      HELD --> AVAILABLE: Nhả hoặc hết hạn
    }
    state "SeatHold" as Hold {
      [*] --> ACTIVE
      ACTIVE --> CONVERTED: Checkout
      ACTIVE --> RELEASED: Chủ nhả
      ACTIVE --> H_EXPIRED: Hết hạn
    }
    note right of SOLD
      MVP không chuyển SOLD về AVAILABLE.
      Refund không tự bán lại ghế.
    end note

    note right of VALID
      CheckIn ONLINE / COUNTER giữ VALID.
      Admission mới chuyển USED.
    end note
