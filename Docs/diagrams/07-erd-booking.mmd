    %% ADR-014: physical FK groups; full columns and constraints in schema.sql.
    booking_items {
        bigint id PK
        bigint booking_id FK
        bigint session_seat_id FK
        bigint session_id FK
    }
    bookings {
        bigint id PK,FK
        bigint customer_id FK
        bigint session_id FK
        bigint event_id FK
        bigint hold_id FK,UK
        varchar status
        datetime expires_at
        bigint confirmed_payment_id FK
    }
    check_ins {
        bigint id PK
        bigint ticket_id FK,UK
        bigint actor_id FK
        datetime checked_in_at
    }
    event_sessions {
        bigint id PK
    }
    events {
        bigint id PK,FK
    }
    payments {
        bigint id PK
        bigint booking_id FK
        varchar status
        bigint pending_booking_guard UK
    }
    refunds {
        bigint id PK
        bigint payment_id FK
        bigint requested_by FK
        bigint approved_by FK
        bigint support_report_id FK
        varchar status
        varchar provider FK
        bigint full_refund_guard UK
    }
    reservation_quotas {
        bigint customer_id PK,FK
        bigint session_id PK,FK
    }
    seat_hold_items {
        bigint id PK
        bigint hold_id FK
        bigint session_seat_id FK
        bigint session_id FK
    }
    seat_holds {
        bigint id PK
        bigint customer_id FK
        bigint session_id FK
        varchar status
        datetime expires_at
    }
    seats {
        bigint id PK
    }
    session_seats {
        bigint id PK
        bigint session_id FK
        bigint seat_id FK
        bigint layout_id FK
        bigint ticket_type_id FK
        varchar status
        bigint hold_id FK
        bigint current_booking_id FK
    }
    support_reports {
        bigint id PK
    }
    ticket_types {
        bigint id PK
    }
    tickets {
        bigint id PK,FK
        bigint booking_item_id FK,UK
        bigint session_seat_id FK
        binary ticket_code_hash UK
        varchar status
        bigint admission_check_in_id FK
        datetime admitted_at
        bigint admitted_by FK
        bigint active_seat_guard UK
    }
    users {
        bigint id PK
    }
