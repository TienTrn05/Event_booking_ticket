flowchart TB
    PUBLIC["Public Web<br/>Customer + Organizer"] -->|"HTTPS /api/v1"| ROUTE["Route → Middleware → Controller"]
    ADMIN["Admin Web<br/>Frontend server riêng"] -->|"HTTPS /api/v1"| ROUTE
    ROUTE --> AUTH["Auth / User service<br/>JWT · Phiên · Quyền"]
    ROUTE --> EVENT["Event / Venue catalog / Layout / Session service"]
    ROUTE --> BOOK["Booking service<br/>Hold · Checkout · Expiry"]
    ROUTE --> PAY["Payment service<br/>Kết quả · Đối soát · Refund"]
    ROUTE --> TICKET["Ticket service<br/>Mã / QR · CheckIn · Admission"]
    BOOK --> UOW["Unit of Work<br/>Một transaction · Một connection"]
    PAY --> UOW
    TICKET --> UOW
    EVENT --> UOW
    AUTH --> UOW
    ROUTE --> ORG["Organization / Membership / Review / Report service"]
    ORG --> UOW
    UOW --> REPO["Repository<br/>SQL có tham số · Khóa hàng"]
    REPO --> DB[("MySQL / InnoDB")]
    PAY -->|"Sau commit"| ADAPTER["Payment adapter<br/>Mock / Provider thật"]
    WORKER["Worker cùng codebase<br/>Expiry · Inbox · Outbox · Đối soát"] --> BOOK
    WORKER --> PAY
    WORKER --> ORG
    WORKER --> DB
    NOTE["Hai frontend · Một backend<br/>Controller không có nghiệp vụ<br/>Không gọi mạng trong transaction"]
