# SERVER ONLY. Copy with npm run setup:env. Never commit real values.
NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_app_user
DB_PASSWORD=replace_me
DB_NAME=event_ticketing
DATABASE_POOL_MAX=10
DB_LOCK_TIMEOUT_SECONDS=5
LOG_LEVEL=info
# Reserved for future auth/ticket modules. setup:env generates independent random keys.
JWT_ACCESS_SECRET=GENERATE_ME
OTP_HMAC_KEY=GENERATE_ME
TICKET_ENCRYPTION_KEY=GENERATE_ME
# Google/SMS/email/payment adapters are NOT implemented or enabled yet.
