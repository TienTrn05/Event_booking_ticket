# SERVER ONLY. Copy with npm run setup:env. Never commit real values.
NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_me
DB_NAME=event_ticketing
DATABASE_POOL_MAX=10
DB_LOCK_TIMEOUT_SECONDS=5
LOG_LEVEL=info
# Server-only auth/ticket keys. setup:env generates independent random keys.
JWT_ACCESS_SECRET=GENERATE_ME
JWT_ISSUER=eventix-api
JWT_AUDIENCE=eventix-web
# Enable Google auth by setting all four values. Register this exact redirect URI in Google Cloud.
# Local example: PUBLIC_APP_URL=http://127.0.0.1:5173/
# Local example: GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
OTP_HMAC_KEY=GENERATE_ME
TICKET_ENCRYPTION_KEY=GENERATE_ME
# Google auth is enabled only when the four Google/public URL values are set.
# Email OTP SMTP and payOS implemented; company-email login deferred.

# Email OTP: set together with PUBLIC_APP_URL, JWT_ACCESS_SECRET, OTP_HMAC_KEY.
# SMTP_USER=your-sender@gmail.com
# SMTP_PASSWORD=your-google-app-password
# Gmail SMTP TLS 465; real secrets only in BE/.env, never in FE or Git.

# Cloudflare R2: set all five together; backend only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://your-public-image-host.example
# Existing R3_Account_ID / R3_ACCESS_KEY_ID / R3_SECRET_ACCESS_KEY /
# R3_BUCKET_NAME / R3_URL are supported aliases; R3_URL is the PUBLIC URL.

# Per-ticket CCCD: independent server-only AES/HMAC master key (64 lowercase hex).
# ATTENDEE_PII_KEY=GENERATE_ME
# Redis is shared by API instances. Keep the password and URL outside Git.
# REDIS_PASSWORD=GENERATE_ME
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379
# REDIS_PREFIX=eventix
# WAITING_ROOM_CAPACITY=100
# WAITING_ROOM_MAX_QUEUE=10000
# WAITING_ROOM_ADMIT_PER_SECOND=20
# WAITING_ROOM_LEASE_SECONDS=600
# One payOS channel; copy credentials from payOS, never generate them in code.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
