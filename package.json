{
  "name": "event-ticketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "BE",
    "Fe"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run dev -w @event-ticketing/web",
    "dev:full": "concurrently -k -n API,WEB \"npm run dev -w @event-ticketing/api\" \"npm run dev -w @event-ticketing/web\"", 
    "dev:api": "npm run dev -w @event-ticketing/api",
    "dev:web": "npm run dev -w @event-ticketing/web",
    "setup:env": "node BE/tooling/setup-env.mjs",
    "db:check": "npm run db:check -w @event-ticketing/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint --config BE/tooling/eslint.config.mjs BE Fe --max-warnings 0",
    "format": "prettier --write \"{BE,Fe}/src/**/*.{ts,tsx,css}\" \"{BE,Fe}/tests/**/*.ts\" \"BE/tooling/*.{ts,mjs,json}\" \"{BE,Fe}/*.{json,html,ts,md}\" package.json .github/workflows/*.yml",
    "format:check": "prettier --check \"{BE,Fe}/src/**/*.{ts,tsx,css}\" \"{BE,Fe}/tests/**/*.ts\" \"BE/tooling/*.{ts,mjs,json}\" \"{BE,Fe}/*.{json,html,ts,md}\" package.json .github/workflows/*.yml",
    "test": "vitest run --config BE/tooling/vitest.config.ts",
    "check:secrets": "node BE/tooling/check-secrets.mjs",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm test && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
